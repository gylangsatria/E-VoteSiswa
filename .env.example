# Salin menjadi .env dan sesuaikan. Jangan commit nilai produksi.
# Gunakan: docker compose --env-file .env up -d

DB_USERNAME=root
DB_PASSWORD=ubah_password_kuat_ini
DB_NAME=db_pilketos

# 40+ karakter acak. Contoh generate: openssl rand -hex 32
ENCRYPTION_KEY=ganti_dengan_kunci_acak_minimal_40_karakter

# Base URL aplikasi (WAJIB di produksi, cegah Host Header Injection).
# Contoh: https://vote.sekolah.sch.id/
APP_BASE_URL=

# production (sembunyikan error) atau development
CI_ENV=production

# set "1" bila memakai HTTPS agar cookie hanya dikirim via HTTPS
SESSION_MATCH_IP=0

# Timezone aplikasi (jadwal voting memakai waktu lokal). Default: Asia/Jakarta
APP_TIMEZONE=Asia/Jakarta