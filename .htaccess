<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect HTTP to HTTPS (uncomment for production)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Remove index.php from URLs
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<IfModule mod_authz_core.c>
    # Apache 2.4
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "(^Dockerfile|Dockerfile\.|^Makefile$|^Jenkinsfile$|^Procfile$)">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(md|sql|log|env|json|lock|ya?ml|ini|sh|conf|dist|bak|swp|orig|save|copy|example)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2
    <FilesMatch "^\.">
        Deny from all
    </FilesMatch>
    <FilesMatch "(^Dockerfile|Dockerfile\.|^Makefile$|^Jenkinsfile$|^Procfile$)">
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(md|sql|log|env|json|lock|ya?ml|ini|sh|conf|dist|bak|swp|orig|save|copy|example)$">
        Deny from all
    </FilesMatch>
</IfModule>

# Protect sensitive directories
RedirectMatch 403 ^/(application|system|user_guide|docker|vendor)(/|$)
RedirectMatch 403 /\.git(/|$)

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8
